# BotFather bergan token.
BOT_TOKEN=
DATABASE_PATH=./data/bot.sqlite
# PostgreSQL uchun DATABASE_URL va ixtiyoriy DATABASE_URL_UNPOOLED ni kiriting.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Render web xizmatida BOT_MODE=webhook va quyidagi ikkita maxfiy qiymatdan foydalaning.
BOT_MODE=polling
# WEBHOOK_SECRET=
# SCHEDULER_SECRET=
# WEBHOOK_BASE_URL=
LOG_LEVEL=info
TIMEZONE=Asia/Tashkent

# Vergul bilan ajratilgan, operator boshqaradigan RSS manbalari.
RSS_FEEDS=https://www.theverge.com/rss/index.xml,https://techcrunch.com/feed/
INGEST_INTERVAL_MINUTES=10
SCHEDULER_TICK_SECONDS=15
MAX_NEWS_AGE_HOURS=48
DEFAULT_DAILY_LIMIT=5
MAX_CHANNELS_PER_USER=10

# uz-title: MyMemory orqali o‘zbekcha sarlavha. en: asl RSS sarlavhasi.
# uz: LLM orqali o‘zbekcha sarlavha va xulosa, LLM_ENABLED=true talab qiladi.
NEWS_LANGUAGE=uz-title
LLM_ENABLED=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
LLM_JSON_MODE=true
